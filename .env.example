# Supabase: copie a conexão "Session pooler" (porta 5432) em Connect.
# Não use Project URL nem Publishable key. Codifique caracteres reservados da senha na URI.
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@POOLER_HOST:5432/postgres"
BETTER_AUTH_SECRET="GERE_UM_SEGREDO_DE_PELO_MENOS_32_CARACTERES"
BETTER_AUTH_URL="http://localhost:3000"
